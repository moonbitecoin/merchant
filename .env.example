# Database
DATABASE_URL=postgresql://moonbite:moonbite@localhost:5432/moonbite_dev

# Redis
REDIS_URL=redis://localhost:6379

# MinIO (S3-compatible)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_PRODUCTS=moonbite-products
MINIO_BUCKET_AVATARS=moonbite-avatars

# JWT & Auth
JWT_SECRET=your-super-secret-jwt-key-change-in-production-32-chars-min
JWT_ALGORITHM=HS256
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Encryption
ENCRYPTION_KEY=your-32-byte-hex-encryption-key-for-aes-256-gcm-change-in-prod

# Email
MAILPIT_HOST=localhost
MAILPIT_PORT=1025
SMTP_FROM_EMAIL=noreply@moonbite.org
SMTP_FROM_NAME=MoonBite

# Payment
CONFIRMATIONS_REQUIRED=2
MOCK_CHAIN_ENABLED=true
WEBHOOK_SIGNING_SECRET=your-webhook-signing-secret-change-in-production
WEBHOOK_MAX_RETRIES=5

# API
API_PORT=3001
API_HOST=0.0.0.0
API_BASE_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WEBSOCKET_URL=ws://localhost:3001

# Security
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
SESSION_COOKIE_SECURE=false

# Feature flags
FEATURE_TOTP_2FA=true
FEATURE_AFFILIATES=true
FEATURE_SUBSCRIPTIONS=true
FEATURE_REVIEWS=true

# Logging
LOG_LEVEL=debug
NODE_ENV=development

# Environment
APP_NAME=MoonBite Merchant Hub
APP_VERSION=1.0.0
