{
  "name": "@moonbite/db",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./client": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "prisma generate && node -e \"require('fs').cpSync('src/client', 'dist', { recursive: true, force: true })\"",
    "typecheck": "echo 'Prisma types are checked during build'",
    "lint": "echo 'Prisma schema is validated during build'",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:seed": "node prisma/seed.cjs",
    "db:studio": "prisma studio",
    "prisma:generate": "prisma generate",
    "prisma:format": "prisma format"
  },
  "prisma": {
    "seed": "node prisma/seed.cjs"
  },
  "dependencies": {
    "@prisma/client": "^5.8.0",
    "@moonbite/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "prisma": "^5.8.0",
    "typescript": "^5.3.3"
  }
}
