# MoonBite Merchant Hub - Ubuntu Environment Configuration
# Copy this file to: /opt/moonbite/merchant/.env.production
# And fill in the values below

# ============================================================================
# ENVIRONMENT & LOGGING
# ============================================================================
NODE_ENV=production
LOG_LEVEL=info

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================
API_HOST=0.0.0.0
API_PORT=3001
HOST=0.0.0.0
PORT=3001

# ============================================================================
# DATABASE (LOCAL POSTGRESQL)
# ============================================================================
# Format: postgresql://username:password@host:port/database
# Replace PASSWORD_HERE with your actual PostgreSQL password
DATABASE_URL=postgresql://moonbite:PASSWORD_HERE@localhost:5432/merchant_prod

# ============================================================================
# REDIS (LOCAL)
# ============================================================================
# Format: redis://default:password@host:port
# For local Redis without password:
REDIS_URL=redis://localhost:6379

# ============================================================================
# SECURITY SECRETS
# ============================================================================
# Generate these with: openssl rand -base64 32
# DO NOT share these values
JWT_SECRET=yAk83ieldaYDWuSzM4eYmPSADYGWht9MEKUhewLKuBc=
ENCRYPTION_KEY=T7FPuqenC2EmHzvAYp0PKp5Wt4080pcxZP4Thcx9kIU=

# ============================================================================
# CORS (ALLOWED ORIGINS)
# ============================================================================
# For local testing:
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://YOUR_SERVER_IP:3001

# For production with domain:
# CORS_ORIGIN=https://merchant.example.com,https://example.com

# ============================================================================
# FRONTEND CONFIGURATION
# ============================================================================
# For local testing:
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# For production with domain:
# NEXT_PUBLIC_API_URL=https://merchant.example.com/api

# For production with IP:
NEXT_PUBLIC_API_URL=http://YOUR_SERVER_IP:3001/api

# ============================================================================
# EMAIL CONFIGURATION (MAILPIT FOR LOCAL TESTING)
# ============================================================================
SMTP_FROM_NAME=MoonBite Merchant
SMTP_FROM_EMAIL=noreply@moonbite.org
MAILPIT_HOST=localhost
MAILPIT_PORT=1025

# Optional: For production SMTP (SendGrid, Mailgun, etc.)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=SG.your_sendgrid_key

# ============================================================================
# BLOCKCHAIN (OPTIONAL)
# ============================================================================
# Use mock blockchain for testing (no real MBITE network needed)
MOCK_CHAIN_ENABLED=true

# For production with real blockchain:
# MOCK_CHAIN_ENABLED=false
# CHAIN_RPC_URL=https://rpc.moonbite.org
# CONFIRMATIONS_REQUIRED=6

# ============================================================================
# STORAGE (OPTIONAL - MINIO/S3)
# ============================================================================
# Leave empty to disable file storage (files won't be served)
# For production, set up real S3 or MinIO

# MINIO_ENDPOINT=minio.example.com
# MINIO_PORT=9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_USE_SSL=true
# MINIO_BUCKET_PRODUCTS=products

# ============================================================================
# NOTES FOR UBUNTU DEPLOYMENT
# ============================================================================
# 1. Replace PASSWORD_HERE with your PostgreSQL password
#
# 2. Replace YOUR_SERVER_IP with your actual server IP address
#    (e.g., 67.205.154.64)
#
# 3. For testing locally on the server:
#    - CORS_ORIGIN=http://localhost:3001
#    - NEXT_PUBLIC_API_URL=http://localhost:3001/api
#
# 4. For testing from another machine:
#    - CORS_ORIGIN=http://SERVER_IP:3001
#    - NEXT_PUBLIC_API_URL=http://SERVER_IP:3001/api
#
# 5. For production with domain (after DNS setup):
#    - CORS_ORIGIN=https://merchant.example.com
#    - NEXT_PUBLIC_API_URL=https://merchant.example.com/api
#
# 6. Email: Mailpit is configured for local testing
#    - Check emails at http://localhost:8025 (if exposed)
#    - For production, set up real SMTP
#
# 7. Database: PostgreSQL runs locally
#    - User: moonbite
#    - Database: merchant_prod
#    - Host: localhost
#    - Port: 5432
#
# 8. Redis: Runs locally without authentication
#    - Host: localhost
#    - Port: 6379
#
# ============================================================================
