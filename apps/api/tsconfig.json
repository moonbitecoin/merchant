{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "module": "ES2020",
    "target": "ES2020",
    "noEmit": false,
    "skipLibCheck": true,
    "noImplicitAny": false
  },
  "include": ["src"],
  "exclude": ["dist", "node_modules", "**/*.test.ts"],
  "ts-node": {
    "transpileOnly": true,
    "compilerOptions": {
      "noEmit": true
    }
  }
}
