# MoonBite Merchant Hub - Production Environment Variables
# Copy to .env.production and fill in your values
# DO NOT commit .env.production to git (it contains secrets)

# ============================================================================
# ENVIRONMENT
# ============================================================================
NODE_ENV=production
LOG_LEVEL=info

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================
API_HOST=0.0.0.0
API_PORT=8080
HOST=0.0.0.0
PORT=8080

# ============================================================================
# DATABASE (DigitalOcean Managed PostgreSQL)
# ============================================================================
# Format: postgresql://username:password@host:port/database
# DigitalOcean provides this automatically when you create the app
DATABASE_URL=postgresql://doadmin:YOUR_PASSWORD@merchant-db.ondigitalocean.com:25060/merchant_prod

# ============================================================================
# REDIS (DigitalOcean Managed Redis)
# ============================================================================
# Format: redis://default:password@host:port
# DigitalOcean provides this automatically when you create the app
REDIS_URL=redis://default:YOUR_PASSWORD@merchant-redis.ondigitalocean.com:25061

# ============================================================================
# SECURITY & ENCRYPTION
# ============================================================================
# JWT secret for signing access/refresh tokens (256-bit base64)
# Generate: openssl rand -base64 32
JWT_SECRET=GENERATE_WITH_openssl_rand_base64_32

# Encryption key for file storage (256-bit base64)
# Used for AES-256-GCM encryption of product files
# Generate: openssl rand -base64 32
ENCRYPTION_KEY=GENERATE_WITH_openssl_rand_base64_32

# ============================================================================
# CORS CONFIGURATION
# ============================================================================
# Comma-separated list of allowed origins for cross-origin requests
CORS_ORIGIN=https://merchant.moonbite.org,https://moonbite.org

# ============================================================================
# EMAIL CONFIGURATION (SMTP)
# ============================================================================
# Email sender name and address
SMTP_FROM_NAME=MoonBite Merchant
SMTP_FROM_EMAIL=noreply@moonbite.org

# Mailpit (local email testing service) - for development
# For production, use SendGrid, Mailgun, or AWS SES
MAILPIT_HOST=localhost
MAILPIT_PORT=1025

# Production SMTP (uncomment and fill in):
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=SG.YOUR_API_KEY

# ============================================================================
# NEXT.JS FRONTEND CONFIGURATION
# ============================================================================
# API endpoint for frontend to use
NEXT_PUBLIC_API_URL=https://api.merchant.moonbite.org

# Public app URL (used in emails, webhooks, etc.)
NEXT_PUBLIC_APP_URL=https://merchant.moonbite.org

# ============================================================================
# OPTIONAL: MINIO (S3-compatible storage)
# ============================================================================
# For digital goods storage (optional - can use S3 instead)
# Leave blank to disable MinIO, handle via S3 or other storage
MINIO_ENDPOINT=
MINIO_PORT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_USE_SSL=true
MINIO_BUCKET_PRODUCTS=products

# ============================================================================
# OPTIONAL: BLOCKCHAIN CONFIGURATION
# ============================================================================
# Enable mock blockchain adapter (for testing without real MBITE network)
MOCK_CHAIN_ENABLED=false

# Real blockchain RPC endpoints (if MOCK_CHAIN_ENABLED=false)
# CHAIN_RPC_URL=https://rpc.moonbite.org
# CONFIRMATIONS_REQUIRED=6

# ============================================================================
# OPTIONAL: RATE LIMITING
# ============================================================================
# These are defined in @moonbite/shared package
# Uncomment to override defaults:
# RATE_LIMIT_API_MAX=100
# RATE_LIMIT_API_WINDOW_MS=900000

# ============================================================================
# OPTIONAL: WEBHOOK CONFIGURATION
# ============================================================================
# HMAC secret for signing webhook payloads
# WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET

# ============================================================================
# OPTIONAL: PAYMENT SETTINGS
# ============================================================================
# Platform fee percentage (2% default)
# PLATFORM_FEE_PERCENT=2

# ============================================================================
# NOTES FOR DIGITALOCEAN DEPLOYMENT
# ============================================================================
# 1. DATABASE_URL and REDIS_URL are auto-populated by DigitalOcean
#    when you connect a managed database. Copy them from the app.yaml:
#    - ${db.connection_string}
#    - ${redis.connection_string}
#
# 2. JWT_SECRET and ENCRYPTION_KEY must be generated and added as
#    "Secrets" in the DigitalOcean App Platform console
#
# 3. For custom domain, update CORS_ORIGIN and NEXT_PUBLIC_API_URL
#    to match your domain after DNS is configured
#
# 4. Email configuration: Set up real SMTP (SendGrid, Mailgun, etc.)
#    before going live. Mailpit is for local dev only.
#
# ============================================================================
